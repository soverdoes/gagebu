rules_version = '2';

/* 가계부 접근 규칙
 *
 * 핵심: 가계부 데이터는 households/{hid} 아래에만 있고,
 *      그 가구의 members 에 든 사람만 읽고 쓸 수 있다.
 *      로그인하지 않은 사람은 아무것도 읽지 못한다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function household(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }
    function isMember(hid) {
      return signedIn() && request.auth.uid in household(hid).members;
    }

    /* 내 프로필 — 내가 어느 가구에 속하는지만 담는다. 본인만 접근. */
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    /* 초대 코드 → 가구 id.
       코드를 아는 사람만 그 가구를 찾을 수 있다(문서 id 가 곧 코드).
       목록 조회(list)는 막아서 코드를 훑어볼 수 없게 한다. */
    match /invites/{code} {
      allow get:    if signedIn();
      allow list:   if false;
      allow create: if isMember(request.resource.data.hid);
      allow delete: if isMember(resource.data.hid);
      allow update: if false;
    }

    match /households/{hid} {
      /* 가구 문서: 이름과 구성원 목록 */
      allow get, list: if isMember(hid);

      allow create: if signedIn()
                    && request.resource.data.members == [request.auth.uid];

      /* 수정은 구성원만. 단, 초대 코드로 들어오는 사람은
         "자기 자신만 members 에 추가"하는 변경 하나만 허용한다.
         (참여자는 가구 문서를 읽을 수 없으므로 클라이언트는 arrayUnion 으로 쓴다) */
      allow update: if isMember(hid)
                    || (signedIn()
                        && !(request.auth.uid in resource.data.members)
                        && request.resource.data.members ==
                             resource.data.members.concat([request.auth.uid])
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['members']));

      allow delete: if isMember(hid) && household(hid).members.size() == 1;

      /* 실제 가계부 데이터 — 구성원만 */
      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }

    /* 그 밖의 모든 경로는 차단 */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
